# steadybull.net data-refresh schedule.
# Install for the deploy user:  crontab /srv/steadybull/deploy/crontab   (replaces their crontab)
# Times are LOCAL (droplet TZ = America/New_York, set during provisioning). Each job runs the CLI
# inside the running app container; the CLI's own logs land in /data/logs/wheel-screener.log, and
# cron-level errors (docker down, etc.) go to $HOME/steadybull-cron.log.
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# earnings calendar — daily, pre-market. This is the OFFLINE FALLBACK only: with FMP__API_KEY set,
# screens and searches refresh the calendar live on every request (a snapshot goes stale silently,
# and every symbol it loses reads downstream as "no earnings scheduled" — issue #113).
# The job now fails loudly and keeps the previous file rather than writing a truncated calendar.
0 6 * * *  cd /srv/steadybull && docker compose exec -T app wheel-screener refresh-earnings >> $HOME/steadybull-cron.log 2>&1

# fundamentals for recent reporters — daily, right after the earnings refresh
30 6 * * *  cd /srv/steadybull && docker compose exec -T app wheel-screener refresh-fundamentals >> $HOME/steadybull-cron.log 2>&1

# precompute a fresh screen through the market day (Mon–Fri) so the dashboard stays current.
# (each run briefly double-loads the fundamentals store in a second process; fine with swap —
#  the lazy-load issue would remove the double load.)
#
# The first and last runs are placed around the two moments the Portfolio tab's Close? verdicts
# are meant to be read: just after the open, and in time to act before the close. A run takes
# 2-4 minutes, so the late one starts at 15:35 to be ready by 15:45 rather than at the bell.
# The verdicts themselves are NOT precomputed — they are priced live when the tab is opened (a
# chain pull per open put, cached ~10 min) — so this keeps the SUGGESTIONS fresh, not the flags.
40 9 * * 1-5  cd /srv/steadybull && docker compose exec -T app wheel-screener refresh-screen >> $HOME/steadybull-cron.log 2>&1
0 12,14 * * 1-5  cd /srv/steadybull && docker compose exec -T app wheel-screener refresh-screen >> $HOME/steadybull-cron.log 2>&1
35 15 * * 1-5  cd /srv/steadybull && docker compose exec -T app wheel-screener refresh-screen >> $HOME/steadybull-cron.log 2>&1
