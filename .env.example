# Copy to .env and fill in. Env vars nest with a "__" delimiter (pydantic-settings).

# --- Schwab Trader / Market Data API (OAuth) ---
# Register a "Market Data Production" app at https://developer.schwab.com
# Approval takes a few days; the refresh token expires every 7 days (re-run `wheel-screener auth-login`).
SCHWAB__CLIENT_ID=
SCHWAB__CLIENT_SECRET=
SCHWAB__CALLBACK_URL=https://127.0.0.1:8182
SCHWAB__TOKEN_PATH=.secrets/schwab_token.json

# --- Alpaca (optional alternative chain source) ---  https://alpaca.markets
# Higher rate limit (~1000/min) + key/secret auth (no weekly OAuth). Opt in with CHAIN_SOURCE=alpaca.
# CHAIN_SOURCE=alpaca
# ALPACA__API_KEY=
# ALPACA__API_SECRET=
# ALPACA__FEED=indicative   # free (delayed/modified); "opra" = paid real-time
# ALPACA__TRADING_BASE_URL=https://paper-api.alpaca.markets   # ONLY for paper-account keys (default is live)

# --- Financial Modeling Prep ---  https://site.financialmodelingprep.com
# Also the source of ex-dividend dates (the ex-div warning); without it the warning is off.
FMP__API_KEY=
FMP__BASE_URL=https://financialmodelingprep.com/stable
# Separate Ultimate-tier key for the ONE-TIME whole-market bulk load (tools/fmp_bulk_import.py).
# Read from this env var, --api-key, or .env. Not needed for normal screening/refresh.
FMP_BULK_API_KEY=

# --- IV rank source: store (roll-your-own SQLite) | orats | flashalpha ---
IV_RANK__SOURCE=store
IV_RANK__DB_PATH=data/iv_history.sqlite
IV_RANK__FLASHALPHA_API_KEY=
IV_RANK__ORATS_TOKEN=

# --- Web app auth (HTTP Basic) ---
# The gate is ENABLED only when AUTH__PASSWORD is set; unset = open (local dev). /health and
# /static stay open. Caddy adds TLS on top; this is app-level defense.
# In production set AUTH__REQUIRED=true (the deploy container does) — the app then REFUSES TO
# START without a password, so a forgotten secret crashes the deploy instead of exposing the app.
AUTH__USER=admin
AUTH__PASSWORD=
AUTH__REQUIRED=false

# --- Portfolio ---
# The short-term interest rate a put holder earns on the strike cash by exercising early — the
# early-assignment test for held short puts. The verdict isn't sensitive to a point either way.
# PORTFOLIO__CARRY_RATE=0.04

# --- Put swap rule (Portfolio "Close?" column) ---
# DRAFT limits: the rule has not been backtested against simply holding to expiry.
# SWAP__USED_UP_YIELD=0.10  # a put still paying this much is not used up, whatever is on offer
# SWAP__MIN_RATIO=2.0     # rule 1: a fresh put must pay this many times the open one
# SWAP__MIN_EXTRA=100     # rule 2: dollars of extra premium over the days left, after cost
# SWAP__SWAP_COST=10      # commission plus the bid/ask loss the quotes don't already carry
# SWAP__TOP_N=3           # other-ticker suggestions shown beside the same-ticker pick

# --- Rate limiting (per-IP throttle on the expensive endpoints: screen starts + ticker search) ---
# On by default; protects a public instance's shared API quota + droplet. Cheap reads are exempt.
# RATE_LIMIT__ENABLED=true
# RATE_LIMIT__PER_MINUTE=20

# --- Runtime paths (point these at the mounted volume in the deploy container) ---
# Defaults are repo-relative for local dev; the slim fundamentals store from tools/slim_store.py
# goes in DATA_DIR. CHAIN_SOURCE=alpaca is the production chain source (see Alpaca block above).
# DATA_DIR=data/fundamentals
# EARNINGS_PATH=data/earnings_calendar.csv
# JOBS_DB_PATH=data/jobs.sqlite
# LOG__DIR=logs
